<?xml version="1.0"?>
<!--
  The whole cell: the world frame, the fixtures generated from cell.yaml, and
  the UR5e macro generated from the DH table, mounted on top of the pedestal.

  This file is hand-written and the two it includes are not. That split is
  deliberate: the generated files carry every dimension, and this one carries
  only the assembly, so a geometry change never touches a hand-edited file.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm_cell">
  <xacro:arg name="prefix" default=""/>

  <xacro:include filename="$(find cell_description)/urdf/ur5e.urdf.xacro"/>
  <xacro:include filename="$(find cell_description)/urdf/cell.urdf.xacro"/>
  <xacro:include filename="$(find cell_description)/urdf/ros2_control.urdf.xacro"/>

  <link name="world"/>

  <!-- The fixtures can be left out for Gazebo, whose world file already has
       them as static models: spawning them a second time, as massless links
       on the arm, is two copies of the conveyor in one place. -->
  <xacro:arg name="with_fixtures" default="true"/>
  <xacro:if value="$(arg with_fixtures)">
    <xacro:cell_fixtures parent="world"/>
  </xacro:if>

  <xacro:ur5e prefix="$(arg prefix)" parent="world">
    <!-- Top of the pedestal. Matches frames.arm_base_xyz in cell.yaml. -->
    <origin xyz="0 0 0.75" rpy="0 0 0"/>
  </xacro:ur5e>

  <!-- The hardware interface. Guarded by an argument so that the description
       can still be loaded on its own, for RViz or for a URDF parse, without
       pulling in a ros2_control block that only means something when a
       controller manager is running. -->
  <xacro:arg name="use_ros2_control" default="true"/>
  <xacro:if value="$(arg use_ros2_control)">
    <xacro:cell_ros2_control/>
  </xacro:if>
</robot>
