<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cell_description</name>
  <version>0.1.0</version>
  <description>
    URDF and xacro for the UR5e arm and the cell furniture, generated from
    simulation/cell.yaml and the DH table by simulation/generate_cell.py.
  </description>
  <maintainer email="114424105+CGainsWorks@users.noreply.github.com">CGainsWorks</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
