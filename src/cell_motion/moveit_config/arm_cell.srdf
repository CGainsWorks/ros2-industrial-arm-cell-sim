<?xml version="1.0"?>
<!--
  Semantic description for MoveIt2.

  The disabled-collision list is the part worth reading. Adjacent links are
  disabled because they share a joint origin and always touch. Links two apart
  are disabled because the 90-degree twist between UR joints means their
  collision cylinders genuinely overlap at reachable configurations without the
  arm being in any danger. Nothing further apart is disabled: the elbow
  reaching the wrist is a real collision and MoveIt should say so.

  The gripper against the pedestal is NOT disabled. It is reachable and it is
  a crash.
-->
<robot name="arm_cell">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0.3007"/>
    <joint name="shoulder_lift_joint" value="-1.4599"/>
    <joint name="elbow_joint" value="-1.4034"/>
    <joint name="wrist_1_joint" value="-1.8490"/>
    <joint name="wrist_2_joint" value="1.5708"/>
    <joint name="wrist_3_joint" value="-1.2701"/>
  </group_state>

  <end_effector name="gripper" parent_link="tool0" group="arm"/>
  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="base_link"/>

  <disable_collisions link1="base_link" link2="shoulder_pan_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="shoulder_lift_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="pedestal_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_pan_link" link2="shoulder_lift_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_pan_link" link2="elbow_link" reason="Never"/>
  <disable_collisions link1="shoulder_pan_link" link2="pedestal_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_lift_link" link2="elbow_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_lift_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="shoulder_lift_link" link2="pedestal_link" reason="Never"/>
  <disable_collisions link1="elbow_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="elbow_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
</robot>
